# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (по умолчанию, для небольших установок)
DB_TYPE=sqlite
SQLITE_PATH=./data/server.db

# PostgreSQL (рекомендуется для продакшена с >100 пользователей)
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=steambot
# DB_USER=steambot
# DB_PASSWORD=your-strong-password
# DB_SSL=false

# ── JWT ───────────────────────────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО СМЕНИТЬ В ПРОДАКШЕНЕ! (минимум 32 символа)
JWT_SECRET=your-super-secret-jwt-key-change-me-in-production-32chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── Admin (создаётся автоматически при первом запуске) ────────────────────────
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=change-me-immediately
ADMIN_NAME=Administrator

# ── App URL (для ссылок в email, Mini App) ────────────────────────────────────
APP_URL=https://your-domain.com

# ── Trial ─────────────────────────────────────────────────────────────────────
TRIAL_DAYS=3

# ── Stripe (опционально, для платных подписок) ────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── Email (опционально, для уведомлений и верификации) ────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@your-domain.com

# ── Playwright ────────────────────────────────────────────────────────────────
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SLOW_MO=100
PLAYWRIGHT_RETRIES=2

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_PUBLIC=100
RATE_LIMIT_MAX_AUTH=20
