'use strict';

/**
 * server/services/SteamLoginManager.js
 *
 * Управляет сессиями входа Steam для веб-дашборда.
 *
 * Два режима:
 *   mode='qr'          — QR-код (скан мобильным приложением Steam)
 *   mode='credentials' — Логин/пароль + Steam Guard
 *
 * Статусы:
 *   starting → loading → waiting (qr) | waiting_credentials (creds)
 *   → checking_credentials → waiting_guard → checking_guard → done
 *   | expired | error | cancelled
 */

const { chromium } = require('playwright');
const crypto       = require('crypto');

let logger;
try { logger = require('../logger'); }
catch { logger = { info: console.log, warn: console.warn, error: console.error }; }

// ── Константы ────────────────────────────────────────────────────────────────

const STEAM_LOGIN_URL = 'https://store.steampowered.com/login/?redir=&redir_ssl=1';
const SESSION_TTL_MS  = 5 * 60 * 1000;
const REAL_UA =
  'Mozilla/5.0 (Windows NT 10.0; Win64; x64) ' +
  'AppleWebKit/537.36 (KHTML, like Gecko) ' +
  'Chrome/121.0.0.0 Safari/537.36';

const sessions = new Map();

// ── Селекторы ────────────────────────────────────────────────────────────────

const QR_BTN_SEL = [
  'button.qr_sign_in', '[class*="QrCode"]', '[data-testid*="qr"]',
  'button:has-text("QR")', 'button:has-text("Use the Steam Mobile App")',
  'button:has-text("Sign in via QR")', '.QRSignInButton', '[class*="qr"]',
];

const QR_IMG_SEL = [
  // inline data-URI (часто QR рендерится как data:image/png)
  'img[src^="data:image/png"]',
  'img[src^="data:image/svg"]',
  // Классы React SPA
  '[class*="QR"] img', '[class*="qr"] img',
  '[class*="QRCode"] img',
  // Canvas (некоторые реализации QR)
  'canvas',
  // Атрибуты alt
  'img[alt*="QR"]', 'img[alt*="qr"]',
];

const USERNAME_SEL  = 'input[type="text"]:not([type="hidden"]):not([name="term"]), input[autocomplete="username"], #input_username';
const PASSWORD_SEL  = 'input[type="password"], input[autocomplete="current-password"], #input_password';
const SUBMIT_SEL    = 'button[type="submit"], button:has-text("Войти"), button:has-text("Sign in"), .btn_blue_steamui';
const GUARD_SEL     = 'input[maxlength="5"], input[maxlength="6"], input[autocomplete="one-time-code"], [class*="twofactor" i] input, [class*="guard" i] input, [class*="TwoFactor"] input, [class*="authcode" i] input, [class*="ConfirmationCode"] input, [class*="SegmentedCharacterInput"] input, input[type="tel"]';

// Кнопки/ссылки для переключения между QR и credentials на Steam Login
const CREDENTIALS_TAB_SEL = [
  'button:has-text("Sign in with Account Name")',
  'button:has-text("Войти с помощью аккаунта")',
  'button:has-text("Войти с помощью имени")',
  'button:has-text("Use account name")',
  'button:has-text("Sign in with credentials")',
  'a:has-text("Sign in with Account Name")',
  'a:has-text("Войти с помощью имени")',
  'a:has-text("Sign in with credentials")',
  '[class*="SignIn"] button', '[class*="signin"] button',
  '[data-panel="login"] button',
  '[class*="ChangeSignInButton"] button',
  '[class*="ChangeSignIn"]',
  // Кнопки/табы переключения
  '[class*="Tab"]:has-text("Sign In")',
  '[class*="Tab"]:has-text("Войти")',
  // Общие паттерны
  'button:has-text("account")',
  'button:has-text("аккаунт")',
  'a:has-text("account")',
];

// ── Внутренние функции ───────────────────────────────────────────────────────

async function _tryClickQR(page) {
  for (const sel of QR_BTN_SEL) {
    try {
      await page.click(sel, { timeout: 1500 });
      logger.info('SteamLoginManager: QR button clicked', { sel });
      await page.waitForTimeout(1200);
      return true;
    } catch { /* next */ }
  }
  return false;
}

/**
 * Переключиться на вкладку «Войти по логину/паролю» (Steam может показывать QR по умолчанию).
 */
async function _tryClickCredentialsTab(page) {
  // Проверяем наличие ПАРОЛЯ — надёжный индикатор формы логина
  // (input[type="text"] может совпасть с поиском Steam)
  try {
    const pwdInput = page.locator(PASSWORD_SEL).first();
    const visible = await pwdInput.isVisible({ timeout: 2000 }).catch(() => false);
    if (visible) {
      logger.info('SteamLoginManager: credentials form already visible (password field found)');
      return true;
    }
  } catch { /* ignore */ }

  // Ищем кнопку переключения на режим логин/пароль
  for (const sel of CREDENTIALS_TAB_SEL) {
    try {
      await page.click(sel, { timeout: 1500 });
      logger.info('SteamLoginManager: credentials tab clicked', { sel });
      await page.waitForTimeout(1500);
      return true;
    } catch { /* next */ }
  }

  // Fallback: кликнуть любую кнопку, которая не относится к QR
  try {
    const buttons = page.locator('button');
    const count = await buttons.count();
    for (let i = 0; i < count; i++) {
      const btn = buttons.nth(i);
      const text = (await btn.textContent().catch(() => '')) || '';
      const lower = text.toLowerCase().trim();
      if (lower.includes('sign in') || lower.includes('войти') || lower.includes('account name') || lower.includes('имен')) {
        await btn.click({ timeout: 2000 });
        logger.info('SteamLoginManager: found credentials button via text scan', { text: lower });
        await page.waitForTimeout(1500);
        return true;
      }
    }
  } catch { /* ignore */ }

  logger.warn('SteamLoginManager: could not find credentials tab, proceeding anyway');
  return false;
}

async function _destroySession(session) {
  sessions.delete(session.sessionId);
  // Снимаем блокировку навигации если была
  if (session._navBlocker && session.page) {
    try { await session.page.unroute('**/*', session._navBlocker); } catch { /* ignore */ }
    session._navBlocker = null;
  }
  try { await session.browser.close(); } catch { /* ignore */ }
}

async function _runSession(session) {
  const { page, context, sessionId, mode } = session;
  try {
    session.status = 'loading';

    await page.goto(STEAM_LOGIN_URL, { waitUntil: 'domcontentloaded', timeout: 180_000 });
    await page.waitForTimeout(2500);

    // Проверяем, что остались на странице логина
    const afterUrl = page.url();
    logger.info('SteamLoginManager: page loaded', { sessionId, url: afterUrl });
    if (!afterUrl.includes('/login')) {
      logger.warn('SteamLoginManager: redirected away from login, retrying', { sessionId, url: afterUrl });
      await page.goto(STEAM_LOGIN_URL, { waitUntil: 'domcontentloaded', timeout: 60_000 });
      await page.waitForTimeout(3000);
      logger.info('SteamLoginManager: retry page at', { sessionId, url: page.url() });
    }

    if (mode === 'qr') {
      await _tryClickQR(page);
      session.status = 'waiting';
    } else {
      // Для credentials — только отмечаем, что страница загружена.
      // Переключение на вкладку и заполнение формы выполнит fillCredentials().
      // Это исключает race condition между _runSession и fillCredentials.
      session.status = 'waiting_credentials';
    }

    // ── Ожидание авторизации ─────────────────────────────────────────
    // Единственный надёжный критерий: cookie steamLoginSecure
    // При mobile auth: возвращаемся на login-страницу, чтобы Steam JS
    // продолжил polling, и по подтверждению — установил cookie.
    const COOKIE_URLS = [
      'https://store.steampowered.com',
      'https://steamcommunity.com',
      'https://help.steampowered.com',
      'https://login.steampowered.com',
    ];

    const deadline = Date.now() + SESSION_TTL_MS;
    let lastLoggedUrl = '';
    let lastScreenshot   = 0;     // timestamp последнего debug-скриншота
    let lastCookieLog    = 0;     // timestamp последнего лога cookies

    while (Date.now() < deadline) {
      if (['cancelled', 'expired'].includes(session.status)) return;
      try {
        // ── 0. Debug screenshot (каждые ~5 сек) ──────────────────
        const now0 = Date.now();
        if (now0 - lastScreenshot > 5_000) {
          lastScreenshot = now0;
          try {
            const buf = await page.screenshot({ type: 'jpeg', quality: 40, timeout: 5_000 });
            session._debugScreenshot = buf.toString('base64');
          } catch { /* page closed */ }
        }

        // ── 0b. Log all cookies (каждые ~10 сек) ─────────────────
        if (now0 - lastCookieLog > 10_000) {
          lastCookieLog = now0;
          try {
            const allCk = await context.cookies(COOKIE_URLS);
            const names = allCk.map(c => `${c.name}@${c.domain}`).join(', ');
            logger.info('SteamLoginManager: cookies snapshot', { sessionId, count: allCk.length, names });
          } catch { /* ignore */ }
        }

        // ── 1. Cookie-check ──────────────────────────────────────
        const ck = await context.cookies(COOKIE_URLS);
        const loginCookie = ck.find(c => c.name === 'steamLoginSecure' && c.value);
        if (loginCookie) {
          logger.info('SteamLoginManager: steamLoginSecure found', { sessionId, domain: loginCookie.domain });
          // Снимаем навигационный блокер
          if (session._navBlocker) {
            await page.unroute('**/*', session._navBlocker).catch(() => {});
            session._navBlocker = null;
          }
          break;
        }

        // ── 2. URL change detection (только для логирования) ────
        const curUrl = page.url();
        if (curUrl !== lastLoggedUrl) {
          lastLoggedUrl = curUrl;
          logger.info('SteamLoginManager: page at', { sessionId, url: curUrl });
        }

        // ── 3. Мобильный аутентификатор ─────────────────────────
        // Навигация заблокирована в fillCredentials — страница
        // остаётся на /login, Steam JS polling работает.
        // Просто ждём появления steamLoginSecure cookie.
      } catch { /* браузер закрыт */ break; }
      await page.waitForTimeout(1500);
    }

    // ── Финальная проверка ──────────────────────────────────────
    // Снимаем навигационный блокер перед финальной навигацией
    if (session._navBlocker) {
      await page.unroute('**/*', session._navBlocker).catch(() => {});
      session._navBlocker = null;
    }
    const finalCookies = await context.cookies(COOKIE_URLS).catch(() => []);
    const hasLogin = finalCookies.some(c => c.name === 'steamLoginSecure' && c.value);
    if (!hasLogin) {
      // Последняя попытка: навигируемся на store и проверяем
      try {
        const finalUrl = page.url();
        if (finalUrl.includes('/login')) {
          await page.goto('https://store.steampowered.com/', { waitUntil: 'domcontentloaded', timeout: 30_000 });
          await page.waitForTimeout(2000);
        }
      } catch { /* ignore */ }
      const lastCookies = await context.cookies(COOKIE_URLS).catch(() => []);
      const hasLoginFinal = lastCookies.some(c => c.name === 'steamLoginSecure' && c.value);
      if (!hasLoginFinal) {
        if (!['cancelled', 'expired'].includes(session.status)) {
          session.status = 'expired';
        }
        return;
      }
    }

    await page.waitForTimeout(2000);
    session.cookies = await context.cookies(COOKIE_URLS).catch(() => context.cookies().catch(() => []));
    session.status  = 'done';

    logger.info('SteamLoginManager: login done', { sessionId, userId: session.userId });
  } catch (err) {
    if (!['cancelled', 'expired'].includes(session.status)) {
      logger.error('SteamLoginManager: error', { sessionId, err: err.message });
      session.status = 'error';
      session.error  = err.message;
    }
  }
  setTimeout(() => _destroySession(session), 30_000);
}

// ── Публичный API ─────────────────────────────────────────────────────────────

async function startSession(userId, name, targetUrl = null, mode = 'qr') {
  const sessionId = crypto.randomUUID();

  const browser = await chromium.launch({
    headless: true,
    args: ['--no-sandbox', '--disable-setuid-sandbox', '--disable-dev-shm-usage', '--disable-gpu'],
  });

  const context = await browser.newContext({
    userAgent:  REAL_UA,
    viewport:   { width: 1280, height: 860 },
    locale:     'ru-RU',
    timezoneId: 'Europe/Moscow',
  });

  // 30 секунд — дефолт для click/fill/waitFor; навигация — 5 минут
  context.setDefaultTimeout(30_000);
  context.setDefaultNavigationTimeout(SESSION_TTL_MS);

  const page = await context.newPage();

  const session = {
    sessionId, browser, context, page,
    status: 'starting', mode,
    userId, name, targetUrl,
    cookies: null,
    createdAt: Date.now(),
    expiresAt: Date.now() + SESSION_TTL_MS,
    error: null, _savedProfileId: null,
  };

  sessions.set(sessionId, session);

  setTimeout(() => {
    const s = sessions.get(sessionId);
    if (s && !['done', 'cancelled'].includes(s.status)) {
      s.status = 'expired';
      _destroySession(s);
    }
  }, SESSION_TTL_MS);

  _runSession(session).catch(err =>
    logger.error('SteamLoginManager: unhandled', { err: err.message }),
  );

  return sessionId;
}

/**
 * Скриншот только QR-элемента (png base64).
 * Пробует найти элемент по селекторам; если не нашёл — обрезает правую
 * часть страницы, где Steam обычно показывает QR.
 */
async function getQRCode(sessionId) {
  const session = sessions.get(sessionId);
  if (!session) return null;
  if (['done', 'expired', 'error', 'cancelled'].includes(session.status)) return null;

  const { page } = session;

  // Пробуем найти конкретный QR-элемент
  for (const sel of QR_IMG_SEL) {
    try {
      const loc = page.locator(sel).first();
      const visible = await loc.isVisible({ timeout: 800 }).catch(() => false);
      if (!visible) continue;

      const bb = await loc.boundingBox();
      // QR-код — квадратный, обычно 80–400 пикселей
      if (!bb || bb.width < 60 || bb.width > 500 || Math.abs(bb.width - bb.height) > bb.width * 0.3) continue;

      const pad = 14;
      const buf = await page.screenshot({
        type: 'png',
        clip: {
          x: Math.max(0, bb.x - pad),
          y: Math.max(0, bb.y - pad),
          width:  bb.width  + pad * 2,
          height: bb.height + pad * 2,
        },
      });
      return buf.toString('base64');
    } catch { /* next selector */ }
  }

  // Fallback: правая треть страницы (там QR у Steam)
  try {
    const vp = page.viewportSize();
    if (vp) {
      const buf = await page.screenshot({
        type: 'png',
        clip: { x: vp.width * 0.52, y: vp.height * 0.25, width: vp.width * 0.42, height: vp.height * 0.55 },
      });
      return buf.toString('base64');
    }
  } catch { /* ignore */ }

  return null;
}

/** Полный скриншот страницы (jpeg base64). */
async function getScreenshot(sessionId) {
  const session = sessions.get(sessionId);
  if (!session) return null;
  if (['done', 'expired', 'error', 'cancelled'].includes(session.status)) {
    // Для завершённых сессий — отдаём последний debug-скриншот
    return session._debugScreenshot || null;
  }
  try {
    const buf = await session.page.screenshot({ type: 'jpeg', quality: 82 });
    return buf.toString('base64');
  } catch {
    return session._debugScreenshot || null;
  }
}

function getStatus(sessionId) {
  const session = sessions.get(sessionId);
  if (!session) return { status: 'not_found' };
  return {
    status:    session.status,
    mode:      session.mode,
    userId:    session.userId,
    name:      session.name,
    cookies:   session.status === 'done' ? session.cookies : undefined,
    targetUrl: session.targetUrl,
    expiresAt: session.expiresAt,
    error:     session.error || undefined,
  };
}

/**
 * Заполнить форму входа (режим credentials).
 * Переключает на вкладку логина, заполняет поля, кликает "Войти".
 * @returns {{ needsGuard: boolean }}
 */
async function fillCredentials(sessionId, username, password) {
  const session = sessions.get(sessionId);
  if (!session) throw new Error('Сессия не найдена');

  // Разрешаем повторные попытки: если прошлая попытка упала → сбрасываем
  if (['done', 'expired', 'cancelled'].includes(session.status)) {
    throw new Error(`Сессия завершена — статус: ${session.status}`);
  }
  if (session.status === 'error') {
    session.status = 'waiting_credentials';
    session.error  = null;
  }

  const { page } = session;
  const OP = 10_000; // 10 сек — макс. на одну операцию click/fill

  try {
    logger.info('SteamLoginManager: fillCredentials start', { sessionId, url: page.url() });

    // 0. Проверяем что мы на странице логина. Если нет — навигируемся.
    const curUrl = page.url();
    if (!curUrl.includes('/login')) {
      logger.warn('SteamLoginManager: NOT on login page, navigating', { sessionId, curUrl });
      await page.goto(STEAM_LOGIN_URL, { waitUntil: 'domcontentloaded', timeout: 60_000 });
      await page.waitForTimeout(3000);
      logger.info('SteamLoginManager: navigated to login page', { sessionId, url: page.url() });
    }

    // 1. Переключаемся на вкладку логин/пароль (Steam может показывать QR по умолчанию)
    await _tryClickCredentialsTab(page);

    // 2. Ждём поле ПАРОЛЯ первым — это надёжный индикатор формы логина
    //    (input[type="text"] совпадает с поиском Steam — нельзя ждать его)
    const passwordInput = page.locator(PASSWORD_SEL).first();
    await passwordInput.waitFor({ state: 'visible', timeout: 30_000 });
    logger.info('SteamLoginManager: password field visible, login form ready', { sessionId });

    // 3. Ищем поле логина через DOM-анализ:
    //    Steam login-форма: поля логина и пароля имеют одинаковый CSS-класс
    //    и находятся внутри общего <form>. Поиск Steam (name="term") — вне формы.
    let usernameInput = null;
    try {
      const handle = await page.evaluateHandle(() => {
        const pwd = document.querySelector('input[type="password"]');
        if (!pwd) return null;
        const cls = pwd.className ? pwd.className.split(' ')[0] : '';

        // Стратегия A: ближайший <form> предок → input[type=text] с тем же классом
        const form = pwd.closest('form');
        if (form && cls) {
          const el = form.querySelector('input[type="text"].' + CSS.escape(cls));
          if (el) return el;
        }
        // Стратегия A2: любой text-input внутри формы (кроме поиска)
        if (form) {
          const el = form.querySelector('input[type="text"]:not([name="term"])');
          if (el) return el;
        }

        // Стратегия B: text-input с тем же классом, что и пароль (без <form>)
        if (cls) {
          const all = document.querySelectorAll('input[type="text"].' + CSS.escape(cls));
          if (all.length) return all[0];
        }

        // Стратегия C: исключаем поиск Steam, берём первый видимый text-input
        const inputs = document.querySelectorAll('input[type="text"]:not([name="term"]):not([type="hidden"])');
        for (const inp of inputs) {
          if (inp.offsetParent !== null) return inp;
        }
        return null;
      });

      const el = handle.asElement();
      if (el) {
        usernameInput = el;
        logger.info('SteamLoginManager: username input found via DOM analysis', { sessionId });
      }
    } catch (e) {
      logger.warn('SteamLoginManager: DOM analysis failed', { sessionId, err: e.message });
    }

    // Fallback: общий USERNAME_SEL (уже с :not([name="term"]))
    if (!usernameInput) {
      logger.warn('SteamLoginManager: DOM analysis found nothing, trying USERNAME_SEL fallback', { sessionId });
      const loc = page.locator(USERNAME_SEL).first();
      const vis = await loc.isVisible({ timeout: 3_000 }).catch(() => false);
      if (vis) usernameInput = loc;
    }

    if (!usernameInput) {
      // Сохраняем скриншот для диагностики
      try {
        const buf = await page.screenshot({ type: 'jpeg', quality: 50, timeout: 5_000 });
        session._debugScreenshot = buf.toString('base64');
      } catch { /* не критично */ }
      throw new Error('Не удалось найти поле логина на странице входа');
    }

    await usernameInput.click({ force: true, timeout: OP });
    await usernameInput.fill('', { force: true, timeout: OP });
    await usernameInput.fill(username, { force: true, timeout: OP });
    logger.info('SteamLoginManager: username filled', { sessionId });

    // 4. Заполняем пароль
    await passwordInput.click({ force: true, timeout: OP });
    await passwordInput.fill(password, { force: true, timeout: OP });
    logger.info('SteamLoginManager: password filled', { sessionId });

    // 4. Отправляем форму
    // 4a. Ставим навигационный блокер ПЕРЕД submit:
    //     Steam после проверки credentials пытается редиректнуть на магазин.
    //     Нам нужно остаться на /login, чтобы Steam JS polling дождался
    //     подтверждения мобильного аутентификатора и установил cookies.
    const navBlocker = async (route) => {
      const req = route.request();
      if (req.isNavigationRequest() && req.resourceType() === 'document') {
        const url = req.url();
        if (!url.includes('/login')) {
          logger.info('SteamLoginManager: BLOCKED navigation away from login', { sessionId, url });
          await route.abort();
          return;
        }
      }
      await route.continue();
    };
    await page.route('**/*', navBlocker);
    session._navBlocker = navBlocker;
    logger.info('SteamLoginManager: navigation blocker installed', { sessionId });

    const submitBtn = page.locator(SUBMIT_SEL).first();
    await submitBtn.click({ force: true, timeout: OP });
    session.status = 'checking_credentials';
    logger.info('SteamLoginManager: credentials submitted', { sessionId });

    // 5. Ждём реакции Steam (Guard / моб. аутентификатор / ошибка / cookie)
    //    Навигация заблокирована — страница остаётся на /login,
    //    Steam JS polling работает, ждёт подтверждения с телефона.
    let detectedMobileAuth = false;
    let detectedGuard = false;
    const checkDeadline = Date.now() + 15_000;

    while (Date.now() < checkDeadline) {
      await page.waitForTimeout(500);

      // Cookie уже есть?
      const cookieUrls = [
        'https://store.steampowered.com',
        'https://steamcommunity.com',
        'https://login.steampowered.com',
      ];
      const ck = await session.context.cookies(cookieUrls).catch(() => []);
      if (ck.some(c => c.name === 'steamLoginSecure' && c.value)) {
        logger.info('SteamLoginManager: login already complete (cookie found)', { sessionId });
        // Снимаем блокер — логин завершён
        await page.unroute('**/*', navBlocker).catch(() => {});
        session._navBlocker = null;
        return { needsGuard: false };
      }

      // Guard visible?
      const guardInput = page.locator(GUARD_SEL).first();
      const guardVis = await guardInput.isVisible({ timeout: 500 }).catch(() => false);
      if (guardVis) {
        detectedGuard = true;
        // Снимаем блокер — Guard не требует навигации
        await page.unroute('**/*', navBlocker).catch(() => {});
        session._navBlocker = null;
        break;
      }

      // Mobile auth text?
      const bodyText = await page.textContent('body', { timeout: 1_000 }).catch(() => '');
      const isMobile = /мобильное приложение|steam mobile app|confirm.*sign.?in|подтвердить вход|two.?factor|check your phone/i.test(bodyText);
      if (isMobile) {
        detectedMobileAuth = true;
        // НЕ снимаем блокер — оставляем страницу на /login для polling
        break;
      }

      // Ошибка входа?
      const errSel = '[class*="FormError"], [class*="newlogindialog_FormError"], .error_ctn, [data-error]';
      const errEl = page.locator(errSel).first();
      const errVis = await errEl.isVisible({ timeout: 300 }).catch(() => false);
      if (errVis) {
        const txt = (await errEl.textContent({ timeout: 1_000 }).catch(() => ''))?.trim();
        if (txt && txt.length > 2) {
          await page.unroute('**/*', navBlocker).catch(() => {});
          session._navBlocker = null;
          session.status = 'error';
          session.error  = txt;
          throw new Error(txt);
        }
      }
    }

    // Если не обнаружили mobile/guard за 15 сек — возможно навигация
    // заблокировала redirect, но текст мобильного auth не появился.
    // Проверим ещё раз: если блокер ловил redirect — скорее всего mobile auth.
    if (!detectedMobileAuth && !detectedGuard) {
      detectedMobileAuth = true;
      logger.info('SteamLoginManager: no explicit signal, assuming mobile auth (nav blocker active)', { sessionId });
    }

    if (detectedMobileAuth) {
      session.status = 'waiting_mobile_confirm';
      logger.info('SteamLoginManager: mobile authenticator confirmation required', { sessionId });
      return { needsMobileConfirm: true };
    }

    if (detectedGuard) {
      session.status = 'waiting_guard';
      logger.info('SteamLoginManager: guard code required', { sessionId });
      return { needsGuard: true };
    }

    // Ни Guard, ни mobile auth → предполагаем Guard
    session.status = 'waiting_guard';
    logger.info('SteamLoginManager: no guard/error detected yet, assuming guard needed', { sessionId });
    return { needsGuard: true };
  } catch (err) {
    // Сохраняем debug-скриншот для диагностики
    try {
      const buf = await page.screenshot({ type: 'jpeg', quality: 50, timeout: 5_000 });
      session._debugScreenshot = buf.toString('base64');
    } catch { /* не критично */ }
    logger.error('SteamLoginManager: fillCredentials error', {
      sessionId, error: err.message, url: page.url(),
    });
    // Не убиваем сессию — пользователь может повторить
    if (!['done', 'expired', 'cancelled', 'error'].includes(session.status)) {
      session.status = 'waiting_credentials';
    }
    throw err;
  }
}

/**
 * Ввести Steam Guard / Mobile Authenticator код.
 */
async function fillGuardCode(sessionId, code) {
  const session = sessions.get(sessionId);
  if (!session) throw new Error('Сессия не найдена');

  const { page } = session;
  const OP = 10_000;
  try {
    const guardInput = page.locator(GUARD_SEL).first();
    await guardInput.waitFor({ state: 'visible', timeout: 15_000 });

    // Очищаем и вводим код
    await guardInput.click({ force: true, timeout: OP });
    await guardInput.fill('', { force: true, timeout: OP });
    await guardInput.fill(code.trim(), { force: true, timeout: OP });
    logger.info('SteamLoginManager: guard code filled', { sessionId });
    await page.waitForTimeout(500);

    // Отправить — кнопка или Enter
    const submitBtn = page.locator(SUBMIT_SEL).first();
    const submitVisible = await submitBtn.isVisible({ timeout: 3_000 }).catch(() => false);
    if (submitVisible) {
      await submitBtn.click({ force: true, timeout: OP });
    } else {
      await page.keyboard.press('Enter');
    }
    session.status = 'checking_guard';
    logger.info('SteamLoginManager: guard code submitted', { sessionId });
  } catch (err) {
    try {
      const buf = await page.screenshot({ type: 'jpeg', quality: 50, timeout: 5_000 });
      session._debugScreenshot = buf.toString('base64');
    } catch { /* не критично */ }
    logger.error('SteamLoginManager: fillGuardCode error', {
      sessionId, error: err.message, url: page.url(),
    });
    if (!['done', 'expired', 'cancelled'].includes(session.status)) {
      session.status = 'waiting_guard';
    }
    throw err;
  }
}

async function cancelSession(sessionId) {
  const session = sessions.get(sessionId);
  if (!session) return;
  session.status = 'cancelled';
  await _destroySession(session);
}

function activeSessions() { return sessions.size; }

function markSaved(sessionId, profileId) {
  const s = sessions.get(sessionId);
  if (s) s._savedProfileId = profileId;
}

function getSavedProfileId(sessionId) {
  return sessions.get(sessionId)?._savedProfileId;
}

function getDebugScreenshot(sessionId) {
  const session = sessions.get(sessionId);
  return session?._debugScreenshot || null;
}

module.exports = {
  startSession, getQRCode, getScreenshot, getStatus,
  fillCredentials, fillGuardCode,
  cancelSession, activeSessions, markSaved, getSavedProfileId,
  getDebugScreenshot,
};
