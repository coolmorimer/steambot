# Steam Poster Bot — переменные окружения сервера лицензий
# Скопируйте этот файл в .env и задайте свои значения

# Порт сервера
PORT=3847

# Секретный токен для admin-эндпоинтов (используется в активаторе)
ADMIN_TOKEN=CHANGE_ME_TO_STRONG_RANDOM_TOKEN

# HMAC-секрет для подписи ответов (должен совпадать с electron/license.js)
# Минимум 32 символа. Генерация: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HMAC_SECRET=CHANGE_ME_TO_STRONG_HMAC_SECRET_32CHARS_MIN
