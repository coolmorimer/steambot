# ── Build stage ─────────────────────────────────────────────────────────────
FROM node:20-bookworm-slim AS builder

WORKDIR /app

# Системные зависимости — для Playwright + native builds (better-sqlite3 etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ \
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 \
    libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 \
    libxrandr2 libgbm1 libasound2 libpango-1.0-0 libpangocairo-1.0-0 \
    libcairo2 libatspi2.0-0 libx11-6 libxext6 libxcb1 libxss1 \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# Копируем server/package.json
COPY server/package.json ./server/
WORKDIR /app/server
RUN npm install --omit=dev

# Установить Playwright браузеры
RUN npx playwright install chromium --with-deps

# ── Production image ─────────────────────────────────────────────────────────
FROM node:20-bookworm-slim

# Создаём пользователя ПЕРВЫМ — до копирования файлов
RUN groupadd -r steambot && useradd -r -g steambot -d /app steambot

WORKDIR /app

# Системные зависимости (runtime only)
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget ca-certificates \
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 \
    libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 \
    libxrandr2 libgbm1 libasound2 libpango-1.0-0 libpangocairo-1.0-0 \
    libcairo2 libatspi2.0-0 libx11-6 libxext6 libxcb1 \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# Создать папки для данных и логов
RUN mkdir -p /app/data /app/logs && chown steambot:steambot /app/data /app/logs

# Копируем node_modules и браузеры из builder (с правильным владельцем сразу)
COPY --chown=steambot:steambot --from=builder /app/server/node_modules ./server/node_modules
COPY --chown=steambot:steambot --from=builder /root/.cache/ms-playwright /app/.cache/ms-playwright

# Копируем исходники сервера
COPY --chown=steambot:steambot server/ ./server/

# Копируем poster.js, db.js и остальные shared модули
COPY --chown=steambot:steambot poster.js    ./
COPY --chown=steambot:steambot db.js        ./
COPY --chown=steambot:steambot scheduler.js ./
COPY --chown=steambot:steambot logger.js    ./
COPY --chown=steambot:steambot bot.js       ./
COPY --chown=steambot:steambot openai.js    ./
COPY --chown=steambot:steambot inventory.js ./

# Симлинк: /app/node_modules → /app/server/node_modules
# Нужен потому что inventory.js, poster.js и др. лежат в /app/ и делают
# require('playwright') — Node ищет в /app/node_modules/, а не /app/server/node_modules/
RUN ln -s /app/server/node_modules /app/node_modules

# Playwright ищет браузеры по PLAYWRIGHT_BROWSERS_PATH
ENV PLAYWRIGHT_BROWSERS_PATH=/app/.cache/ms-playwright

USER steambot

WORKDIR /app/server

EXPOSE 4000

# DB_TYPE по умолчанию — postgresql (для K8s / Docker Compose с PostgreSQL)
ENV DB_TYPE=postgresql

# Часовой пояс сервера — должен совпадать с локальным временем пользователя
# (расписание кампаний задаётся в этом часовом поясе)
ENV TZ=Europe/Moscow

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD wget -qO- http://localhost:4000/health || exit 1

CMD ["node", "app.js"]
