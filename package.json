{
  "name": "steam-bot",
  "version": "1.0.0",
  "description": "Steam Forum Poster Bot — автоматически создаёт темы на форуме Steam через Playwright",
  "author": "SteamBot",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron": "cross-env NODE_ENV=development electron .",
    "build:ui": "vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "build:service": "electron-builder --win portable --config electron-builder.service.json",
    "build:all": "vite build && electron-builder --win portable && electron-builder --win portable --config electron-builder.service.json",
    "cli:start": "node index.js start",
    "cli:status": "node index.js status"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "express": "^5.2.1",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.67.0",
    "playwright": "^1.58.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^9.0.1",
    "winston": "^3.19.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.steambot.poster",
    "productName": "Steam Poster Bot",
    "asar": true,
    "asarUnpack": [
      "**/better-sqlite3/**",
      "**/better_sqlite3.node"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "tray.ico"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "bot.js",
      "poster.js",
      "db.js",
      "scheduler.js",
      "logger.js",
      "telegram.js",
      "ngrok.js",
      "inventory.js",
      "openai.js",
      "webapp-server.js",
      "webapp/**",
      "config/**",
      "node_modules/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Steam Poster Bot Setup.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "shortcutName": "Steam Poster Bot"
    }
  }
}
